<?php

namespace Tests\Feature\ShoppingCart;

use App\Models\Product;
use App\Services\ShoppingCartService;
use App\DTOs\ShoppingCartDTO;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Http\Request;
use Mockery;
use Tests\TestCase;

class ShoppingCartServiceTest extends TestCase
{
    use RefreshDatabase;

    protected $service;
    protected $mockRequest;
    protected $mockSession;

    protected function setUp(): void
    {
        parent::setUp();

        // Create several products in the database for testing
        $this->product1 = Product::factory()->create([
            'price' => 100,
            'discount_price' => 80,
            'stock' => 10,
            'title' => 'Test Product 1',
            'image' => 'test-product-1.jpg'
        ]);

        $this->product2 = Product::factory()->create([
            'price' => 200,
            'discount_price' => 150,
            'stock' => 5,
            'title' => 'Test Product 2',
            'image' => 'test-product-2.jpg'
        ]);

        $this->product3 = Product::factory()->create([
            'price' => 300,
            'discount_price' => 250,
            'stock' => 3,
            'title' => 'Test Product 3',
            'image' => 'test-product-3.jpg'
        ]);

        $this->product4 = Product::factory()->create([
            'price' => 400,
            'discount_price' => 350,
            'stock' => 2,
            'title' => 'Test Product 4',
            'image' => 'test-product-4.jpg'
        ]);

        // Mock the session
        $this->mockSession = Mockery::mock(\Illuminate\Session\Store::class);
        $this->mockSession->shouldReceive('get')
            ->with('shopping_cart', Mockery::on(function ($arg) {
                return $arg instanceof ShoppingCartDTO;
            }))
            ->andReturn(new ShoppingCartDTO());

        // Mock the request
        $this->mockRequest = Mockery::mock(Request::class);
        $this->mockRequest->shouldReceive('session')
            ->andReturn($this->mockSession);

        // Instantiate ShoppingCartService with mocked request
        $this->service = new ShoppingCartService($this->mockRequest);
    }

    /**
     * Test adding multiple items to the cart, including adding Product 1 twice
     */
    public function test_add_multiple_items_to_cart_with_product_1_added_twice()
    {
        // Add multiple products to the cart, adding Product 1 twice with different quantities
        $this->service->addItemToCart($this->product1->id, 2);  // Add 2 of Product 1
        $this->service->addItemToCart($this->product1->id, 3);  // Add 3 more of Product 1
        $this->service->addItemToCart($this->product2->id, 1);  // Add 1 of Product 2
        $this->service->addItemToCart($this->product3->id, 3);  // Add 3 of Product 3
        $this->service->addItemToCart($this->product4->id, 1);  // Add 1 of Product 4

        $cartItems = $this->service->getCartItems();

        // Assert that the cart has four products
        $this->assertCount(4, $cartItems);

        // Assert that Product 1 has a total quantity of 5 (2 + 3)
        $this->assertEquals(5, $cartItems->where('product_id', $this->product1->id)->first()->quantity);

        // Assert correct quantities for other products
        $this->assertEquals(1, $cartItems->where('product_id', $this->product2->id)->first()->quantity); // Product 2 quantity
        $this->assertEquals(3, $cartItems->where('product_id', $this->product3->id)->first()->quantity); // Product 3 quantity
        $this->assertEquals(1, $cartItems->where('product_id', $this->product4->id)->first()->quantity); // Product 4 quantity

        // Assert correct total price (5 * 80 + 1 * 150 + 3 * 250 + 1 * 350)
        $this->assertEquals(80 * 5 + 150 * 1 + 250 * 3 + 350 * 1, $this->service->getTotalPrice());
    }

    /**
     * Test updating quantities of multiple items in the cart
     */
    public function test_update_multiple_items_in_cart()
    {
        // Add initial items to the cart
        $this->service->addItemToCart($this->product1->id, 2);
        $this->service->addItemToCart($this->product2->id, 1);
        $this->service->addItemToCart($this->product3->id, 3);
        $this->service->addItemToCart($this->product4->id, 1);

        // Update product quantities
        $this->service->updateItemQuantityInCart($this->product1->id, 5);
        $this->service->updateItemQuantityInCart($this->product2->id, 2);
        $this->service->updateItemQuantityInCart($this->product3->id, 1);

        // Assert updated quantities
        $cartItems = $this->service->getCartItems();
        $this->assertEquals(5, $cartItems->where('product_id', $this->product1->id)->first()->quantity);  // Product 1 new quantity
        $this->assertEquals(2, $cartItems->where('product_id', $this->product2->id)->first()->quantity);  // Product 2 new quantity
        $this->assertEquals(1, $cartItems->where('product_id', $this->product3->id)->first()->quantity);  // Product 3 new quantity

        // Assert total price after update (5 * 80 + 2 * 150 + 1 * 250 + 1 * 350)
        $this->assertEquals(80 * 5 + 150 * 2 + 250 * 1 + 350 * 1, $this->service->getTotalPrice());
    }

    /**
     * Test removing an item from the cart
     */
    public function test_remove_item_from_cart()
    {
        // Add initial items to the cart
        $this->service->addItemToCart($this->product1->id, 2);
        $this->service->addItemToCart($this->product2->id, 1);
        $this->service->addItemToCart($this->product3->id, 3);
        $this->service->addItemToCart($this->product4->id, 1);

        // Remove product 1 from the cart
        $this->service->removeItemFromCart($this->product1->id);

        // Assert that the cart now only contains product 2, 3, and 4
        $cartItems = $this->service->getCartItems();
        $this->assertCount(3, $cartItems);
        $this->assertNull($cartItems->where('product_id', $this->product1->id)->first()); // Product 1 should not be in the cart
    }

    /**
     * Test calculating the total price of the cart
     */
    public function test_get_total_price()
    {
        // Add multiple items to the cart
        $this->service->addItemToCart($this->product1->id, 2);
        $this->service->addItemToCart($this->product2->id, 1);
        $this->service->addItemToCart($this->product3->id, 3);
        $this->service->addItemToCart($this->product4->id, 1);

        // Assert that the total price is correct (2 * 80 + 1 * 150 + 3 * 250 + 1 * 350)
        $this->assertEquals(80 * 2 + 150 * 1 + 250 * 3 + 350 * 1, $this->service->getTotalPrice());
    }

    /**
     * Test calculating the final price after discounts
     */
    public function test_get_final_price()
    {
        // Add multiple items to the cart
        $this->service->addItemToCart($this->product1->id, 2);
        $this->service->addItemToCart($this->product2->id, 1);
        $this->service->addItemToCart($this->product3->id, 3);
        $this->service->addItemToCart($this->product4->id, 1);

        // Assuming a discount logic is in place that changes the price, we check it here
        // For the sake of simplicity, we're assuming it doesn't apply any additional discount
        $this->assertEquals(80 * 2 + 150 * 1 + 250 * 3 + 350 * 1, $this->service->getFinalPrice());
    }
}
