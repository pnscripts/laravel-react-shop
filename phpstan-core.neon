# PN Shop core modules are held to a stricter level than the legacy app/ code.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # The base tables are created by the core package's migrations.
    databaseMigrationsPath:
        - database/migrations
        - packages/pn-shop-core/database/migrations
    stubFiles:
        - stubs/phpstan/kalnoy-nestedset.stub
    paths:
        - packages/pn-shop-core/src/
        # Plugins shipped with PN Shop are held to the same standard.
        - extensions/pnshop/
        # Contract test kits in core/*/Testing are analysed through the tests that use them.
        - tests/Feature/Payment/BankTransferContractTest.php
        - tests/Feature/Payment/CashOnDeliveryContractTest.php
        - tests/Feature/Shipping/FlatRateContractTest.php
    level: 7
